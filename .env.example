# PostgreSQL connection string. Keep the real value in .env or your deployment environment.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
REDIS_URL=redis://localhost:6379/0

# Initial accounts used by python scripts/seed.py. Replace all placeholder values.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=superadmin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
INITIAL_STAFF_EMAIL=staff@example.com
INITIAL_STAFF_PASSWORD=CHANGE_ME_STAFF_PASSWORD


# Resend email delivery for welcome and booking payment emails.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=no-reply@example.com
