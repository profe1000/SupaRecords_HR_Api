# PostgreSQL connection string. Keep the real value in .env or your deployment environment.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
REDIS_URL=redis://localhost:6379/0

# Initial accounts used by python scripts/seed.py. Replace all placeholder values.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=superadmin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
INITIAL_STAFF_EMAIL=staff@example.com
INITIAL_STAFF_PASSWORD=CHANGE_ME_STAFF_PASSWORD

# Paystack payment settings
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Resend email delivery for welcome and booking payment emails.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=no-reply@example.com

# Apinator realtime settings
# APINATOR_APP_ID: your Apinator application id
# APINATOR_KEY: your Apinator API key
# APINATOR_SECRET: your Apinator secret
# APINATOR_CLUSTER: cluster region (e.g., us, eu). Defaults to 'us' if unset.
APINATOR_APP_ID=
APINATOR_KEY=
APINATOR_SECRET=
APINATOR_CLUSTER=us

# Pusher realtime settings
# PUSHER_APP_ID: your Pusher app id
# PUSHER_KEY: your Pusher key
# PUSHER_SECRET: your Pusher secret
# PUSHER_CLUSTER: cluster region (e.g., eu, us)
# PUSHER_SSL: true/false (default: true)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
PUSHER_SSL=true
